{
  "expo": {
    "name": "DeliveryHub",
    "slug": "deliveryhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "deliveryhub",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deliveryhub.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.deliveryhub.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "DeliveryHub needs camera access to photograph transport slips for OCR processing.",
          "photosPermission": "DeliveryHub needs access to your photos to select transport slip images."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B1220"
          }
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "owner": "darshangirigoswami",
    "extra": {
      "eas": {
        "projectId": "6aac2814-5d1a-4fdc-98ce-df1de71dc00b"
      }
    }
  }
}
