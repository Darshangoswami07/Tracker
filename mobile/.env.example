# Public (non-secret) runtime configuration for the DeliveryHub mobile app.
# Values prefixed with EXPO_PUBLIC_ are inlined at build time by Expo.

# Base URL of the FastAPI backend.
# - Android emulator: http://10.0.2.2:8000
# - iOS simulator / web: http://localhost:8000
# - Physical device: use your machine's LAN IP, e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
