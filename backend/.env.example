# DeliveryHub API - environment variables.
# Copy to `.env` and fill in real values. Never commit `.env`.

# Application
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# PostgreSQL (Neon) - pooled connection string. This is the SINGLE source of
# truth for ALL application/business data. The mobile app never connects here
# directly: Mobile -> FastAPI -> Neon. Use the async psycopg v3 prefix
# (+psycopg) and keep the Neon ?sslmode=require query param.
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require&channel_binding=require
# Separate scratch database for the test suite (drops/recreates the schema
# around every test). MUST differ from DATABASE_URL — e.g. a Neon branch.
TEST_DATABASE_URL=postgresql+psycopg://user:password@host/dbname_test?sslmode=require
# Security - REQUIRED in production (min 32 chars): the app refuses to start
# with the dev default when ENV=production, because a per-process random key
# would invalidate tokens on restart and across API instances.
SECRET_KEY=insecure-development-secret-change-me
ALGORITHM=HS256
JWT_ISSUER=deliveryhub
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# CORS - comma-separated origins, or * for development.
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_WHITELIST=/health,/docs,/redoc,/openapi.json
# Redis failure behaviour (true=allow on error, false=reject on error).
# When unset: fail-open in dev/test, fail-closed in production.
RATE_LIMIT_REDIS_FAILURE_OPEN=

# Per-path rate limit overrides (Phase 6).
# Dashboard reads: higher limit — the frontend polls this on load.
RATE_LIMIT_DASHBOARD_MAX_REQUESTS=120
RATE_LIMIT_DASHBOARD_WINDOW_SECONDS=60
# Admin read/list operations: moderate limit — frequent but not polling.
RATE_LIMIT_ADMIN_READ_MAX_REQUESTS=90
RATE_LIMIT_ADMIN_READ_WINDOW_SECONDS=60
# Admin write/mutation operations: stricter — security-sensitive mutations.
RATE_LIMIT_ADMIN_WRITE_MAX_REQUESTS=30
RATE_LIMIT_ADMIN_WRITE_WINDOW_SECONDS=60
# Auth endpoints (login, register, password): very strict — brute-force protection.
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# OTP endpoints (verify, resend): ultra-strict — code-guessing protection.
RATE_LIMIT_OTP_MAX_REQUESTS=5
RATE_LIMIT_OTP_WINDOW_SECONDS=60

# Redis / Celery - background email delivery.
#   REDIS_URL                - canonical Redis connection string (rate limiter,
#                              cache, etc.). Celery's broker and result backend
#                              default to this value, so this is the only Redis
#                              variable you need to configure.
#   CELERY_BROKER_URL        - task queue broker; optional override (defaults
#                              to REDIS_URL).
#   CELERY_RESULT_BACKEND    - task results; optional override (defaults to
#                              REDIS_URL; unused because task_ignore_result).
#   CELERY_TASK_DEFAULT_QUEUE=deliveryhub
# Production: Redis is REQUIRED for async work. If the broker is unreachable
# the task is dropped and logged (never silently run inside the API process).
# Development: leave CELERY_FALLBACK_IN_PROCESS unset so a missing Redis falls
# back to an in-process background task and flows keep working locally.
# CELERY_FALLBACK_IN_PROCESS=true|false overrides the environment default
# (production=false, development/test=true).
#
# Upstash Redis (TLS). Replace <UPSTASH_TOKEN> with your real token - never
# commit the real token. The token lives only in your local, git-ignored .env.
REDIS_URL=rediss://default:<UPSTASH_TOKEN>@amusing-gorilla-173719.upstash.io:6379
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_DEFAULT_QUEUE=deliveryhub

# In non-production, the forgot-password response includes the reset token.
EXPOSE_RESET_TOKEN_IN_RESPONSE=true

# Email / SMTP - never hardcode credentials. When the selected provider has
# no credentials configured, the EmailService falls back to logging so flows
# still work locally (no fake success is ever returned for a configured
# provider that failed).
#
# Provider selection:
#   EMAIL_PROVIDER=brevo -> Brevo transactional REST API (EMAIL_API_KEY below)
#                           Free tier: 300 emails/day, no credit card.
#                           Sender (jobpilotdesk@gmail.com) must be verified in
#                           the Brevo dashboard -> "Senders" -> verify email.
#   EMAIL_PROVIDER=smtp  -> SMTP transport (SMTP_HOST/USERNAME/PASSWORD below).
#                           NOTE: Gmail SMTP is NOT a production transport —
#                           the 550 5.4.5 daily sending-limit makes it
#                           unreliable. SMTP is only for self-hosted mailboxes.
EMAIL_PROVIDER=brevo
EMAIL_FROM_NAME=DeliveryHub
EMAIL_FROM_EMAIL=jobpilotdesk@gmail.com
EMAIL_API_KEY=
# SMTP is unused while EMAIL_PROVIDER=brevo; left empty to avoid accidental use.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Admin receives a notification for EVERY new registration request.
ADMIN_NOTIFICATION_EMAIL=jobpilotdesk@gmail.com
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BACKOFF_SECONDS=3
# Base URL used to build the "Open Admin Dashboard" action in email.
ADMIN_DASHBOARD_URL=http://localhost:8000/admin/dashboard
# OCR (GR slip extraction) - OCR.Space API key used by POST /admin/orders/ocr-extract.
# When unset, the OCR endpoint returns 503 so the mobile Create GR 'Import From Slip'
# mode shows a clear error instead of failing silently (manual entry still works).
# Get a free key from https://ocr.space/ocrapi.
OCR_SPACE_API_KEY=
OCR_SPACE_API_URL=https://api.ocr.space/parse/image

# Object Storage (Phase 8) - GR attachment uploads.
#   STORAGE_BACKEND  - "local" (development) or "s3" (production).
#   S3_BUCKET        - bucket name (e.g., "deliveryhub-attachments").
#   S3_REGION        - AWS region (e.g., "us-east-1").
#   S3_ACCESS_KEY    - access key ID (leave empty for IAM role on EC2/Render).
#   S3_SECRET_KEY    - secret access key (leave empty for IAM role).
#   S3_ENDPOINT_URL  - optional custom endpoint for MinIO, DigitalOcean Spaces,
#                       Cloudflare R2, etc. Leave empty for standard AWS S3.
#   S3_PRESIGNED_URL_EXPIRY - seconds until download URL expires (default 300).
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=
S3_PRESIGNED_URL_EXPIRY=300
